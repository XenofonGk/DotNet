# Caddy fetches and renews a Let's Encrypt certificate for API_DOMAIN by itself,
# so there is no certbot cron job and nothing to forget to renew.
#
# API_DOMAIN can be an sslip.io name derived from the VM's public address —
# 203-0-113-10.sslip.io resolves to 203.0.113.10 — which means a real
# certificate without owning a domain.

{$API_DOMAIN} {
	encode gzip

	# The API sets its own CORS headers; the proxy must not add a second set,
	# because duplicate Access-Control-Allow-Origin headers make browsers
	# reject the response outright.
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	# Security headers. HSTS is deliberately omitted: it is hard to undo, and
	# this host may move.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
