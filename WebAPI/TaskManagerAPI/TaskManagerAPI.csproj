<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>364c498c-7e21-415e-afd4-969472edbeb0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Pinned above the transitive 2.0.0 that Microsoft.AspNetCore.OpenApi resolves.
         Versions up to 2.7.4 are affected by GHSA-v5pm-xwqc-g5wc, where a circular
         schema reference can terminate OpenAPI parsing. 2.7.5 is the first fixed release.
         Stay on 2.x: ASP.NET Core 10's OpenAPI source generator is written against the
         2.x object model and does not compile against 3.x (CS0200 on IOpenApiMediaType.Example). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
